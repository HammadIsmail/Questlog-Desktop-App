<UserControl x:Class="Questlog.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Questlog.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:ScheduleViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource ContentPadding}">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Tactical Schedule" Style="{StaticResource TextPageTitle}"/>
                    <TextBlock Text="AI-orchestrated itinerary designed to optimize focus blocks and conquer goals." 
                               Style="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Refresh" Style="{StaticResource ButtonGhost}" Margin="0,0,10,0"
                            Command="{Binding LoadScheduleCommand}"/>
                    <Button Content="⚡ Generate AI Schedule" Style="{StaticResource ButtonPrimary}"
                            Command="{Binding GenerateAiScheduleCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator Banner -->
            <Border Background="{StaticResource BrushSurfaceMuted}" BorderBrush="{StaticResource BrushAccent}"
                    BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="100" Height="4"
                                 Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Dungeon Master is calculating your optimal focus itinerary..." 
                               Style="{StaticResource TextBody}" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccentDark}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Error Banner -->
            <Border Background="#FDF2E9" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushAccentDark}" FontSize="12"/>
            </Border>

            <!-- Schedule Items Container -->
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="24">
                <StackPanel>
                    <TextBlock Text="TODAY'S CAMPAIGN BLOCKS" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding ScheduleItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Time slot -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StartTime, StringFormat='{}{0:hh:mm tt}'}" 
                                                       FontFamily="{StaticResource FontMono}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushAccentDark}"/>
                                            <TextBlock Text="{Binding EndTime, StringFormat='{}to {0:hh:mm tt}'}" 
                                                       FontFamily="{StaticResource FontMono}" FontSize="11" 
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>

                                        <!-- Title + duration -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextCardTitle}" FontSize="15"/>
                                            <TextBlock Text="{Binding DurationMinutes, StringFormat='{}{0} minutes allocated'}" 
                                                       Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- ⏩ Shift +30m button (only on incomplete blocks) -->
                                        <Button Grid.Column="2" Content="⏩ Shift +30m"
                                                Style="{StaticResource ButtonGhost}"
                                                Padding="10,5" FontSize="12"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ShiftScheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibility}}"/>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CornerRadius="4" Padding="8,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrushSurfaceMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Scheduled"/>
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Text" Value="✓ Done"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State Placeholder -->
                    <Border Visibility="{Binding HasScheduleItems, Converter={StaticResource InverseBoolToVisibility}}"
                            Padding="32,24" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No campaign blocks planned yet." 
                                       Style="{StaticResource TextCardTitle}" 
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Click '⚡ Generate AI Schedule' above to auto-plan your day from active quests!" 
                                       Style="{StaticResource TextSecondary}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
