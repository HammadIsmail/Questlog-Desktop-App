<UserControl x:Class="Questlog.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Questlog.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:AuthViewModel}">

    <Grid Background="{StaticResource BrushBackground}">
        <!-- Centered Card -->
        <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource BrushSurface}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="1" 
                CornerRadius="12" 
                Padding="36,32">
            <StackPanel>
                <!-- Logo & Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="10" 
                            Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="⚔" FontSize="22" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="QUESTLOG" FontFamily="{StaticResource FontDisplay}" 
                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Real-Life Dungeon Master" Style="{StaticResource TextSecondary}" 
                               FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Auth Mode Title -->
                <TextBlock Text="{Binding SubmitButtonText}" FontFamily="{StaticResource FontDisplay}"
                           FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <!-- Error Alert Box -->
                <Border Background="#FDF2E9" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushAccentDark}"
                               FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Form Fields -->
                <StackPanel Margin="0,0,0,16">
                    <!-- Name Field (Sign Up Only) -->
                    <StackPanel Visibility="{Binding IsSignUpMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                        <TextBlock Text="ADVENTURER NAME" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FormInput}" Padding="12,9" FontSize="13"/>
                    </StackPanel>

                    <!-- Email Field -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FormInput}" Padding="12,9" FontSize="13"/>
                    </StackPanel>

                    <!-- Password Field -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="PASSWORD" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" CornerRadius="6">
                            <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" 
                                         Background="Transparent" BorderThickness="0" 
                                         Padding="12,9" FontSize="13" 
                                         Foreground="{StaticResource BrushTextPrimary}"/>
                        </Border>
                    </StackPanel>

                    <!-- Confirm Password Field (Sign Up Only) -->
                    <StackPanel Visibility="{Binding IsSignUpMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                        <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" CornerRadius="6">
                            <PasswordBox PasswordChanged="ConfirmPasswordBox_PasswordChanged" 
                                         Background="Transparent" BorderThickness="0" 
                                         Padding="12,9" FontSize="13" 
                                         Foreground="{StaticResource BrushTextPrimary}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Primary Action Button -->
                <Button Content="{Binding SubmitButtonText}" 
                        Command="{Binding SubmitCommand}" 
                        Style="{StaticResource ButtonPrimary}" 
                        Padding="16,11" FontSize="14" FontWeight="SemiBold"
                        HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                <!-- Mode Switch Link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,18">
                    <TextBlock Text="{Binding TogglePromptText}" Style="{StaticResource TextSecondary}" 
                               FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Button Content="{Binding ToggleActionText}" Command="{Binding ToggleModeCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{StaticResource BrushAccentDark}" FontWeight="Bold" FontSize="12"
                            Padding="2,0"/>
                </StackPanel>

                <!-- Divider -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Separator Grid.Column="0" VerticalAlignment="Center" Background="{StaticResource BrushBorder}"/>
                    <TextBlock Grid.Column="1" Text="OR" Style="{StaticResource TextSecondary}" 
                               FontSize="11" FontWeight="SemiBold" Margin="12,0"/>
                    <Separator Grid.Column="2" VerticalAlignment="Center" Background="{StaticResource BrushBorder}"/>
                </Grid>

                <!-- Quick Start Button -->
                <Button Content="⚡ Quick Start (Guest Adventurer)" 
                        Command="{Binding QuickStartCommand}" 
                        Style="{StaticResource ButtonGhost}" 
                        Padding="14,9" FontSize="12" FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"/>

                <!-- Loading Bar -->
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                             Foreground="{StaticResource BrushAccent}" Background="Transparent" BorderThickness="0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
