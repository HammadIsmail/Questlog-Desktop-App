<UserControl x:Class="Questlog.Views.GoalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Questlog.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:GoalsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource ContentPadding}">

            <!-- Page Title -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Active Quests" Style="{StaticResource TextPageTitle}"/>
                    <TextBlock Text="Define your daily objectives and conquer high-value achievements." 
                               Style="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="Refresh Quests" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ButtonGhost}" Command="{Binding LoadGoalsCommand}"/>
            </Grid>

            <!-- New Quest Creation Card -->
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="FORGE NEW QUEST" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title Input -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quest Title" Style="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewGoalTitle, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormInput}"/>
                        </StackPanel>

                        <!-- Priority Selector -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Priority" Style="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding NewGoalPriority}">
                                <ComboBoxItem Content="high" IsSelected="True"/>
                                <ComboBoxItem Content="medium"/>
                                <ComboBoxItem Content="low"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Estimated Duration -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Estimate (min)" Style="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewGoalEstimateMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormInput}"/>
                        </StackPanel>

                        <!-- Add Button -->
                        <Button Grid.Column="6" Content="Accept Quest" VerticalAlignment="Bottom"
                                Style="{StaticResource ButtonPrimary}" Padding="18,10"
                                Command="{Binding CreateGoalCommand}"/>
                    </Grid>

                    <!-- Optional Description -->
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Notes / Victory Conditions (Optional)" Style="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewGoalDescription, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FormInput}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Goals List -->
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="20">
                <StackPanel>
                    <TextBlock Text="CURRENT OBJECTIVES" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding Goals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurfaceMuted}" 
                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextCardTitle}" 
                                                           FontSize="16" VerticalAlignment="Center"/>
                                                <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="4" 
                                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Priority}" FontFamily="{StaticResource FontMono}" 
                                                               FontSize="11" Foreground="{StaticResource BrushAccentDark}" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource TextSecondary}" 
                                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding EstimatedMinutes, StringFormat='{}{0} minutes estimated'}" 
                                                           FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Complete" Style="{StaticResource ButtonPrimary}" Padding="12,6" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.CompleteGoalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Abandon" Style="{StaticResource ButtonGhost}" Padding="10,6"
                                                    Command="{Binding DataContext.DeleteGoalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
