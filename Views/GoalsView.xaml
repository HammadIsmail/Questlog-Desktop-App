<UserControl x:Class="Questlog.Views.GoalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Questlog.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:GoalsViewModel}"
             x:Name="GoalsRoot">

    <UserControl.Resources>
        <!-- Orb pulse animation -->
        <Storyboard x:Key="OrbPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OrbGlow"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1.0" To="1.4" Duration="0:0:0.9" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbGlow"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1.0" To="1.4" Duration="0:0:0.9" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.9" Duration="0:0:0.9" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Waveform animations -->
        <Storyboard x:Key="Wave1" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height"
                             From="6" To="38" Duration="0:0:0.45" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="Wave2" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height"
                             From="10" To="52" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="Wave3" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height"
                             From="4" To="60" Duration="0:0:0.5" AutoReverse="True" BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="Wave4" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height"
                             From="8" To="44" Duration="0:0:0.55" AutoReverse="True" BeginTime="0:0:0.2">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="Wave5" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Bar5" Storyboard.TargetProperty="Height"
                             From="6" To="36" Duration="0:0:0.42" AutoReverse="True" BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <!-- Root Grid to layer overlay on top of content -->
    <Grid>

        <!-- ══ MAIN CONTENT ══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource ContentPadding}">

                <!-- Page header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Active Quests" Style="{StaticResource TextPageTitle}"/>
                        <TextBlock Text="Define your daily objectives or speak naturally to have AI forge them into your campaign."
                                   Style="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Refresh Quests" Style="{StaticResource ButtonGhost}"
                                Command="{Binding LoadGoalsCommand}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding ToggleVoicePanelCommand}" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F399;" FontSize="15" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Speak Daily Plan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Manual Quest Forge -->
                <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="FORGE NEW QUEST (MANUAL)" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Quest Title" Style="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewGoalTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Priority" Style="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding NewGoalPriority}">
                                    <ComboBoxItem Content="high" IsSelected="True"/>
                                    <ComboBoxItem Content="medium"/>
                                    <ComboBoxItem Content="low"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Estimate (min)" Style="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewGoalEstimateMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                            </StackPanel>
                            <Button Grid.Column="6" Content="Accept Quest" VerticalAlignment="Bottom"
                                    Style="{StaticResource ButtonPrimary}" Padding="18,10"
                                    Command="{Binding CreateGoalCommand}"/>
                        </Grid>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="Notes / Victory Conditions (Optional)" Style="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewGoalDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Goals List -->
                <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="CURRENT OBJECTIVES" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding Goals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSurfaceMuted}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextCardTitle}" FontSize="16" VerticalAlignment="Center"/>
                                                    <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="4"
                                                            Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Priority}" FontFamily="{StaticResource FontMono}"
                                                                   FontSize="11" Foreground="{StaticResource BrushAccentDark}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock FontFamily="{StaticResource FontMono}" FontSize="12"
                                                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding EstimatedMinutes, StringFormat='{}{0} minutes estimated'}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstimatedMinutes}" Value="{x:Null}">
                                                                    <Setter Property="Text" Value="Flexible duration"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EstimatedMinutes}" Value="0">
                                                                    <Setter Property="Text" Value="Flexible duration"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Complete" Style="{StaticResource ButtonPrimary}" Padding="12,6" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.CompleteGoalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Abandon" Style="{StaticResource ButtonGhost}" Padding="10,6"
                                                        Command="{Binding DataContext.DeleteGoalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ VOICE ASSISTANT OVERLAY (Google Assistant style) ══ -->
        <Grid x:Name="VoiceOverlay"
              Visibility="{Binding IsVoicePanelOpen, Converter={StaticResource BoolToVisibility}}">

            <!-- Dark backdrop -->
            <Border Background="#CC050510"/>

            <!-- Centered floating card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="460" CornerRadius="24" Padding="0,0,0,28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF13131F" Offset="0"/>
                        <GradientStop Color="#FF1A1A2E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#AA000000" BlurRadius="60" ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Top bar: close -->
                    <Grid Margin="20,16,20,0">
                        <TextBlock Text="AI Voice Planner" Foreground="#AAFFFFFF"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding ToggleVoicePanelCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#88FFFFFF" FontSize="16" Cursor="Hand"
                                Content="&#x2715;" Padding="8" Width="34" Height="34"/>
                    </Grid>

                    <!-- Orb + glow -->
                    <Grid Width="160" Height="160" HorizontalAlignment="Center" Margin="0,16,0,20">

                        <!-- Animated glow ring -->
                        <Ellipse x:Name="OrbGlow" Width="160" Height="160"
                                 Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#70E8612A" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Mic button -->
                        <Button x:Name="MicButton" Width="96" Height="96"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding ToggleVoiceListeningCommand}"
                                Cursor="Hand" ToolTip="Click to start/stop listening"
                                BorderThickness="0" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse Width="96" Height="96">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFE8612A" Offset="0"/>
                                                    <GradientStop Color="#FFFF9500" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFE8612A" BlurRadius="22" ShadowDepth="0" Opacity="0.65"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="&#x1F399;" FontSize="34"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Status text -->
                    <TextBlock Text="{Binding VoiceStatusText}"
                               FontSize="15" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="32,0,32,16"/>

                    <!-- Waveform bars (only when listening) -->
                    <StackPanel x:Name="WaveformPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Height="64" Margin="0,0,0,16"
                                Visibility="{Binding IsVoiceListening, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle x:Name="Bar1" Width="5" Height="6" RadiusX="3" RadiusY="3"
                                   VerticalAlignment="Center" Margin="4,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFF9500" Offset="0"/>
                                    <GradientStop Color="#FFE8612A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Bar2" Width="5" Height="10" RadiusX="3" RadiusY="3"
                                   VerticalAlignment="Center" Margin="4,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFF9500" Offset="0"/>
                                    <GradientStop Color="#FFE8612A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Bar3" Width="5" Height="4" RadiusX="3" RadiusY="3"
                                   VerticalAlignment="Center" Margin="4,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFF9500" Offset="0"/>
                                    <GradientStop Color="#FFE8612A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Bar4" Width="5" Height="8" RadiusX="3" RadiusY="3"
                                   VerticalAlignment="Center" Margin="4,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFF9500" Offset="0"/>
                                    <GradientStop Color="#FFE8612A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Bar5" Width="5" Height="6" RadiusX="3" RadiusY="3"
                                   VerticalAlignment="Center" Margin="4,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFF9500" Offset="0"/>
                                    <GradientStop Color="#FFE8612A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </StackPanel>

                    <!-- Live transcript bubble (partial speech) -->
                    <Border Background="#18FFFFFF" CornerRadius="12" Padding="12,8"
                            Margin="32,0,32,8"
                            Visibility="{Binding IsVoiceListening, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SpokenTranscript}"
                                   Foreground="#AAFFFFFF" FontSize="12"
                                   TextWrapping="Wrap" TextAlignment="Center" FontStyle="Italic"/>
                    </Border>

                    <!-- Chat history list -->
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                  Margin="32,0,32,10"
                                  x:Name="ChatScroll">
                        <ItemsControl ItemsSource="{Binding ChatHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <!-- USER bubble: right-aligned -->
                                        <Border HorizontalAlignment="Right" MaxWidth="280"
                                                CornerRadius="14,14,4,14" Padding="12,8"
                                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FFE8612A" Offset="0"/>
                                                    <GradientStop Color="#FFFF9500" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Text}" Foreground="White"
                                                       FontSize="13" TextWrapping="Wrap"/>
                                        </Border>
                                        <!-- ASSISTANT bubble: left-aligned -->
                                        <Border HorizontalAlignment="Left" MaxWidth="300"
                                                Background="#22FFFFFF"
                                                CornerRadius="14,14,14,4" Padding="12,8"
                                                Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                <TextBlock Text="&#x2694;" FontSize="14" VerticalAlignment="Top" Margin="0,0,7,0" Foreground="#FFE8612A"/>
                                                <TextBlock Text="{Binding Text}" Foreground="#EEFFFFFF"
                                                           FontSize="13" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Type input bar -->
                    <Border Margin="32,0" Background="#12FFFFFF" CornerRadius="12" Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding VoiceInputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="White" CaretBrush="White"
                                     FontSize="13" Padding="10,8"
                                     VerticalContentAlignment="Center">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding SubmitVoicePlanCommand}"
                                    Margin="4" Padding="14,8"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#FFE8612A" CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Add to List &#x2192;" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Quick prompt chips -->
                    <WrapPanel HorizontalAlignment="Center" Margin="20,12,20,0">
                        <TextBlock Text="Try:" Foreground="#70FFFFFF" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <Button Style="{StaticResource ButtonGhost}" Padding="8,3" FontSize="11" Margin="0,0,6,4"
                                Command="{Binding QuickSpokenPromptCommand}"
                                CommandParameter="2 hours of DSA and 1 hour of project work">
                            <TextBlock Text="&#x26A1; 2h DSA + 1h Project" Foreground="#BBFFFFFF"/>
                        </Button>
                        <Button Style="{StaticResource ButtonGhost}" Padding="8,3" FontSize="11" Margin="0,0,6,4"
                                Command="{Binding QuickSpokenPromptCommand}"
                                CommandParameter="90 minutes of frontend development and 30 minutes of emails">
                            <TextBlock Text="&#x1F3AF; 90m Frontend" Foreground="#BBFFFFFF"/>
                        </Button>
                        <Button Style="{StaticResource ButtonGhost}" Padding="8,3" FontSize="11" Margin="0,0,6,4"
                                Command="{Binding QuickSpokenPromptCommand}"
                                CommandParameter="1 hour of system design study">
                            <TextBlock Text="&#x1F4DA; 1h System Design" Foreground="#BBFFFFFF"/>
                        </Button>
                    </WrapPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>

