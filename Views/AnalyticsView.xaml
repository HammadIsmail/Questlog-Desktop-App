<UserControl x:Class="Questlog.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Questlog.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:AnalyticsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource ContentPadding}">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Tactical Analytics" Style="{StaticResource TextPageTitle}"/>
                    <TextBlock Text="Performance audit metrics and time allocation distribution." 
                               Style="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="Refresh Metrics" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ButtonGhost}" Command="{Binding LoadAnalyticsCommand}"/>
            </Grid>

            <!-- Metrics Summary Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="TOTAL TIME" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalMinutes, StringFormat='{}{0} min'}" 
                                   FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PRODUCTIVE" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProductiveMinutes, StringFormat='{}{0} min'}" 
                                   FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="UNPRODUCTIVE" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding UnproductiveMinutes, StringFormat='{}{0} min'}" 
                                   FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushDanger}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PRODUCTIVITY RATE" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProductivityPercentage, StringFormat='{}{0:0.#}%'}" 
                                   FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Breakdown & Audit Trail Split -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <!-- Category Breakdown -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="CATEGORY DISTRIBUTION" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding CategoryBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Value, StringFormat='{}{0} min'}" HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Score Audit Log -->
                <Border Grid.Column="2" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="SCORE AUDIT TRAIL" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding ScoreEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Delta badge -->
                                            <Border Grid.Column="0" Background="{StaticResource BrushSurfaceMuted}" 
                                                    CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Delta, StringFormat='{}{0:+0;-0;0}'}" 
                                                           FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{StaticResource BrushAccent}"/>
                                            </Border>

                                            <!-- Reason -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource TextBody}"/>
                                                <TextBlock Text="{Binding EventType}" Style="{StaticResource TextSecondary}" FontSize="11"/>
                                            </StackPanel>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat='{}{0:hh:mm tt}'}" 
                                                       FontFamily="{StaticResource FontMono}" FontSize="11" 
                                                       Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
