<UserControl x:Class="Questlog.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Questlog.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource ContentPadding}">
            
            <!-- Top Hero Row: Score, Rank, Streak, Metrics -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Hero Score Banner -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}" Padding="14,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="CAMPAIGN SCORE" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Score}" FontFamily="{StaticResource FontDisplay}" 
                                           FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                <TextBlock Text=" PTS" FontFamily="{StaticResource FontMono}" FontSize="13" 
                                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="{Binding ScoreLevel}" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentDark}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Streak Card -->
                <Border Grid.Column="2" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}" Padding="12,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="STREAK" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding StreakDays, StringFormat='{}{0} Days'}" 
                                   FontFamily="{StaticResource FontMono}" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Continuous effort" Style="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Productive Time Card -->
                <Border Grid.Column="4" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}" Padding="12,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PRODUCTIVE" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding ProductiveMinutes, StringFormat='{}{0} min'}" 
                                   FontFamily="{StaticResource FontMono}" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource BrushSuccess}"/>
                        <TextBlock Text="Deep focus time" Style="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Current Focus App Card -->
                <Border Grid.Column="6" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}" Padding="12,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CURRENT APP" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CurrentApp}" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource FontBody}" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding CurrentCategory}" Style="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Content Split: Today Quests & Daily Schedule -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Quests Column -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="ACTIVE QUESTS (TODAY)" Style="{StaticResource TextSectionTitle}"/>
                            <Button Content="Refresh" HorizontalAlignment="Right" Style="{StaticResource ButtonGhost}"
                                    Command="{Binding LoadDashboardDataCommand}" Padding="8,4" FontSize="11"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TodayGoals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSurfaceMuted}" 
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextCardTitle}"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource TextSecondary}" 
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Priority, StringFormat='Priority: {0}'}" 
                                                               FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushAccent}"/>
                                                    <TextBlock Text=" • " Foreground="{StaticResource BrushTextSecondary}"/>
                                                    <TextBlock Text="{Binding EstimatedMinutes, StringFormat='{}{0} min est.'}" 
                                                               FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Done" Style="{StaticResource ButtonPrimary}" 
                                                    VerticalAlignment="Center" Padding="10,6" FontSize="11"
                                                    Command="{Binding DataContext.CompleteGoalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Schedule Column -->
                <Border Grid.Column="2" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SCHEDULED ITINERARY" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding TodaySchedule}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" 
                                                       FontFamily="{StaticResource FontMono}" FontSize="13" 
                                                       Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DurationMinutes, StringFormat='{}{0} minutes'}" 
                                                           Style="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
