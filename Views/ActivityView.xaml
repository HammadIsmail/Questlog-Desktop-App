<UserControl x:Class="Questlog.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Questlog.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:ActivityViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource ContentPadding}">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Real-Time Window Tracker" Style="{StaticResource TextPageTitle}"/>
                    <TextBlock Text="Continuous monitoring of active windows and categorized usage sessions." 
                               Style="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushSuccess}" CornerRadius="10" Width="8" Height="8" Margin="0,0,8,0"/>
                    <TextBlock Text="Live Tracking Active" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Sync Activities Now" Style="{StaticResource ButtonPrimary}" 
                            Command="{Binding SyncNowCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Activity Table Container -->
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="20">
                <StackPanel>
                    <TextBlock Text="RECENT APPLICATION SESSIONS" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,16"/>

                    <!-- Skeleton Loading Rows (When IsLoading is true) -->
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Style="{StaticResource SkeletonLine}" Width="100" Height="14" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkeletonLine}" Width="60" Height="10"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SkeletonLine}" Width="260" Height="13" Margin="10,0"/>
                                <Border Grid.Column="2" Style="{StaticResource SkeletonLine}" Width="70" Height="12"/>
                                <Border Grid.Column="3" Style="{StaticResource SkeletonBadge}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Style="{StaticResource SkeletonLine}" Width="120" Height="14" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkeletonLine}" Width="70" Height="10"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SkeletonLine}" Width="310" Height="13" Margin="10,0"/>
                                <Border Grid.Column="2" Style="{StaticResource SkeletonLine}" Width="80" Height="12"/>
                                <Border Grid.Column="3" Style="{StaticResource SkeletonBadge}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Style="{StaticResource SkeletonLine}" Width="90" Height="14" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkeletonLine}" Width="50" Height="10"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SkeletonLine}" Width="200" Height="13" Margin="10,0"/>
                                <Border Grid.Column="2" Style="{StaticResource SkeletonLine}" Width="65" Height="12"/>
                                <Border Grid.Column="3" Style="{StaticResource SkeletonBadge}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Real Activity Items (When IsLoading is false) -->
                    <ItemsControl ItemsSource="{Binding Activities}"
                                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <!-- App Name -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AppName}" Style="{StaticResource TextBody}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource TextSecondary}" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Window Title -->
                                        <TextBlock Grid.Column="1" Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" 
                                                   Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0"/>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="2" Text="{Binding DurationSeconds, StringFormat='{}{0} seconds'}" 
                                                   FontFamily="{StaticResource FontMono}" FontSize="12" 
                                                   Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>

                                        <!-- Productive Badge -->
                                        <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CornerRadius="4" Padding="8,3" Background="{StaticResource BrushSurfaceMuted}">
                                            <TextBlock Text="{Binding IsProductive, Converter={x:Null}}" 
                                                       FontFamily="{StaticResource FontMono}" FontSize="11"
                                                       Foreground="{StaticResource BrushAccentDark}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
