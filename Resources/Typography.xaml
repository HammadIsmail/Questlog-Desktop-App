<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================
         TYPOGRAPHY — UI_UX.md §6
         Source Sans 3 (body), Source Serif 4 (display),
         IBM Plex Mono (numeric/timer)
         Using system fallbacks until fonts embedded
         ===================================================== -->

    <!-- Font families (graceful fallback to system fonts) -->
    <FontFamily x:Key="FontBody">pack://application:,,,/Resources/Fonts/#Source Sans 3, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontDisplay">pack://application:,,,/Resources/Fonts/#Source Serif 4, Georgia, serif</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/Resources/Fonts/#IBM Plex Mono, Consolas, monospace</FontFamily>

    <!-- Font sizes — from Typography Scale UI_UX.md §7 -->
    <system:Double x:Key="FontSizePageTitle" xmlns:system="clr-namespace:System;assembly=mscorlib">30</system:Double>
    <system:Double x:Key="FontSizeSectionTitle" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <system:Double x:Key="FontSizeCardTitle" xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="FontSizeBody" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
    <system:Double x:Key="FontSizeSecondary" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="FontSizeMetric" xmlns:system="clr-namespace:System;assembly=mscorlib">36</system:Double>
    <system:Double x:Key="FontSizeTimer" xmlns:system="clr-namespace:System;assembly=mscorlib">32</system:Double>

    <!-- Base TextBlock styles -->
    <Style x:Key="TextPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="LineHeight" Value="38" />
    </Style>

    <Style x:Key="TextSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="TextCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="TextSecondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>

    <Style x:Key="TextMetric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMetric}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="TextTimer" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTimer}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style x:Key="TextAccentLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>

</ResourceDictionary>
