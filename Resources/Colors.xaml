<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================
         REAL-LIFE DUNGEON MASTER — DESIGN TOKENS
         Warm-neutral palette from UI_UX.md §4
         ===================================================== -->

    <!-- Base -->
    <Color x:Key="ColorBackground">#F4F1EA</Color>
    <Color x:Key="ColorSurface">#FBFAF7</Color>
    <Color x:Key="ColorSurfaceMuted">#ECE9E1</Color>
    <Color x:Key="ColorBorder">#D8D3C8</Color>
    <Color x:Key="ColorTextPrimary">#1D1D1B</Color>
    <Color x:Key="ColorTextSecondary">#68665F</Color>

    <!-- Accent -->
    <Color x:Key="ColorAccent">#D85C32</Color>
    <Color x:Key="ColorAccentDark">#A94223</Color>
    <Color x:Key="ColorAccentSoft">#F2D4C8</Color>

    <!-- Semantic -->
    <Color x:Key="ColorSuccess">#3D7A57</Color>
    <Color x:Key="ColorWarning">#B17A2B</Color>
    <Color x:Key="ColorDanger">#B74A43</Color>
    <Color x:Key="ColorInfo">#496F88</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceMuted" Color="{StaticResource ColorSurfaceMuted}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentDark" Color="{StaticResource ColorAccentDark}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="BrushSidebar" Color="#EFECE4" />

    <!-- Spacing -->
    <Thickness x:Key="ContentPadding">28,24,28,24</Thickness>
    <Thickness x:Key="SectionGap">0,20,0,0</Thickness>
    <Thickness x:Key="ItemGap">0,8,0,0</Thickness>

    <!-- Radius -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">10</CornerRadius>

</ResourceDictionary>
