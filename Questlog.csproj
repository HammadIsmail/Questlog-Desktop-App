<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Questlog</RootNamespace>
    <AssemblyName>Questlog</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Required for WinRT Toast notifications on non-packaged apps -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microphone capture for Voice UI (Phase 3) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- WinRT Toast notifications (Phase 6) -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prevent System.Windows.Forms from colliding with WPF namespaces (UserControl, Application, Timer) -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
