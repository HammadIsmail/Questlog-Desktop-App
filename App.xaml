<Application x:Class="Questlog.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Questlog"
             xmlns:vm="clr-namespace:Questlog.ViewModels"
             xmlns:views="clr-namespace:Questlog.Views"
             xmlns:common="clr-namespace:Questlog.Common">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <common:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

            <!-- ViewModel to View Mappings -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
                <views:ScheduleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GoalsViewModel}">
                <views:GoalsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                <views:AnalyticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
                <views:ActivityView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CoachViewModel}">
                <views:CoachView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuthViewModel}">
                <views:AuthView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
