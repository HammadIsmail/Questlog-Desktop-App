<Window x:Class="Questlog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Questlog.ViewModels"
        mc:Ignorable="d"
        Title="Questlog — Real-Life Dungeon Master" 
        Height="680" Width="1040"
        MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <!-- Nav Button Style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushAccentDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar (Visible when Authenticated) -->
        <Border Grid.Column="0" Width="205" Background="{StaticResource BrushSidebar}" 
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="12,14,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                            <TextBlock Text="⚔" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="QUESTLOG" FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Real-Life Dungeon Master" Style="{StaticResource TextSecondary}" FontSize="10" Margin="34,2,0,0"/>
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="MENU" Style="{StaticResource TextSectionTitle}" Margin="6,0,0,8"/>
                    <Button Content="🎯  Quests &amp; AI Voice" Style="{StaticResource NavButton}" 
                            Command="{Binding NavigateToCommand}" CommandParameter="Goals"/>
                    <Button Content="⏱  Window Tracker" Style="{StaticResource NavButton}" 
                            Command="{Binding NavigateToCommand}" CommandParameter="Activity"/>
                    <Button Content="📈  Analytics" Style="{StaticResource NavButton}" 
                            Command="{Binding NavigateToCommand}" CommandParameter="Analytics"/>
                </StackPanel>

                <!-- Bottom Telemetry Status & User Profile -->
                <StackPanel Grid.Row="3">
                    <!-- User Profile & Sign Out -->
                    <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserDisplay}" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Adventurer" FontSize="9" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Sign Out" Command="{Binding LogoutCommand}"
                                    Style="{StaticResource ButtonGhost}" Padding="6,2" FontSize="10" 
                                    VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Telemetry Status -->
                    <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BrushSuccess}" CornerRadius="10" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Active Monitoring" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Local Daemon Connected" FontSize="9" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Right Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar (Visible ONLY when logged in) -->
            <Border Grid.Row="0" Height="46" Background="{StaticResource BrushSurface}" 
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,0"
                    Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentViewTitle}" FontFamily="{StaticResource FontDisplay}" 
                               FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" 
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDateFormatted}" FontFamily="{StaticResource FontMono}" 
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Global Loader Progress Bar (Underneath Top Bar) -->
                    <ProgressBar Height="3" IsIndeterminate="True" 
                                 Foreground="{StaticResource BrushAccent}" 
                                 Background="Transparent" BorderThickness="0" 
                                 VerticalAlignment="Bottom" Margin="-20,0,-20,-1"
                                 Visibility="{Binding IsGlobalLoading, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- Active View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False"/>
        </Grid>

    </Grid>
</Window>
